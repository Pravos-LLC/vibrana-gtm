{
  "contract": "email-contract-v1",
  "about": "Synthetic parity cases for exact-address email restrictions (VIB-509). Made-up people on .example domains; no real contact. The cockpit (vibrana-gtm) pins a copy by hash and runs its adapter against the same expectations. clientDomains is the private client-domain list used to build the client index for these cases.",
  "clientDomains": ["clientco.example"],
  "base": {
    "id": "00000000-0000-4000-8000-000000000001",
    "name": {"firstName": "Pat", "lastName": "Example"},
    "emails": {"primaryEmail": "pat@alpha.example", "additionalEmails": ["pat.example@mail.example"]},
    "linkedinLink": {"primaryLinkUrl": ""},
    "company": {"id": "c-alpha", "name": "Alpha", "domainName": {"primaryLinkUrl": "https://alpha.example"}},
    "companyId": "c-alpha",
    "gtmOrigins": ["PROSPECT_TOOL"],
    "gtmEligibility": "REVIEW_NEEDED",
    "gtmMarketingConsent": "NONE",
    "gtmQueue": "UNRESOLVED",
    "gtmPriority": "UNRESOLVED",
    "gtmRelationship": "UNKNOWN",
    "gtmRelationshipOwners": [],
    "prospectNotSendable": "",
    "prospectReviewState": "PENDING",
    "gtmOwnedSignals": {"prospect": {"lane": "saas", "signals": {"domain": "alpha.example", "country": "United States"}}}
  },
  "cases": [
    {"name": "clean prospect", "set": {},
     "expect": {"protected": false, "coldExcluded": false, "emailTarget": "pat@alpha.example",
                "refusals": {"": [], "pat@alpha.example": [], "pat.example@mail.example": []}}},
    {"name": "primary address bounced, other address untouched and not substituted",
     "set": {"gtmEmailRestrictions": {"version": 1, "addresses": {"pat@alpha.example": {"reason": "EMAIL_BOUNCED", "source": "gmail_dsn", "observedAt": "2026-11-01T00:00:00Z"}}, "holds": []}},
     "expect": {"protected": false, "coldExcluded": false, "emailTarget": null,
                "refusals": {"": ["address_check_required"], "pat@alpha.example": ["address_email_bounced"], "pat.example@mail.example": []}}},
    {"name": "only an additional address bounced",
     "set": {"gtmEmailRestrictions": {"version": 1, "addresses": {"pat.example@mail.example": {"reason": "EMAIL_BOUNCED"}}, "holds": []}},
     "expect": {"protected": false, "coldExcluded": false, "emailTarget": "pat@alpha.example",
                "refusals": {"": ["address_check_required"], "pat@alpha.example": [], "pat.example@mail.example": ["address_email_bounced"]}}},
    {"name": "address-scoped opt-out stays on that address",
     "set": {"gtmEmailRestrictions": {"version": 1, "addresses": {"pat@alpha.example": {"reason": "ADDRESS_OPT_OUT"}}}},
     "expect": {"protected": false, "coldExcluded": false, "emailTarget": null,
                "refusals": {"pat@alpha.example": ["address_address_opt_out"], "pat.example@mail.example": []}}},
    {"name": "possible opt-out under review holds the person, not protected()",
     "set": {"gtmEmailRestrictions": {"version": 1, "addresses": {}, "holds": [{"reason": "OPT_OUT_REVIEW", "sourceRef": "gtm:label:1"}]}},
     "expect": {"protected": false, "coldExcluded": true, "emailTarget": null,
                "refusals": {"": ["email_hold_opt_out_review"], "pat@alpha.example": ["email_hold_opt_out_review"]}}},
    {"name": "a boolean version fails closed",
     "set": {"gtmEmailRestrictions": {"version": true, "addresses": {}}},
     "expect": {"protected": false, "coldExcluded": true, "emailTarget": null, "refusals": {"": ["email_restrictions_unreadable"]}}},
    {"name": "unknown version fails closed",
     "set": {"gtmEmailRestrictions": {"version": 2, "addresses": {}}},
     "expect": {"protected": false, "coldExcluded": true, "emailTarget": null,
                "refusals": {"": ["email_restrictions_unreadable"], "pat.example@mail.example": ["email_restrictions_unreadable"]}}},
    {"name": "malformed text fails closed",
     "set": {"gtmEmailRestrictions": "not json"},
     "expect": {"protected": false, "coldExcluded": true, "emailTarget": null, "refusals": {"": ["email_restrictions_unreadable"]}}},
    {"name": "entry without a reason fails closed",
     "set": {"gtmEmailRestrictions": {"version": 1, "addresses": {"pat@alpha.example": {}}}},
     "expect": {"protected": false, "coldExcluded": true, "emailTarget": null, "refusals": {"": ["email_restrictions_unreadable"]}}},
    {"name": "trim and case are normalized; dots and plus tags are not folded",
     "set": {"gtmEmailRestrictions": {"version": 1, "addresses": {"  Pat@Alpha.Example ": {"reason": "EMAIL_BOUNCED"}, "pat+news@alpha.example": {"reason": "EMAIL_BOUNCED"}}}},
     "expect": {"protected": false, "coldExcluded": false, "emailTarget": null,
                "refusals": {"PAT@alpha.example": ["address_email_bounced"], "pat.example@mail.example": []}}},
    {"name": "an address the person does not hold is refused",
     "set": {},
     "expect": {"protected": false, "coldExcluded": false, "emailTarget": "pat@alpha.example",
                "refusals": {"someone.else@alpha.example": ["address_not_on_person"]}}},
    {"name": "no address at all",
     "set": {"emails": {"primaryEmail": "", "additionalEmails": []}},
     "expect": {"protected": false, "coldExcluded": false, "emailTarget": null, "refusals": {"": ["no_email_address"]}}},
    {"name": "a legacy textual EMAIL_BOUNCED reason (written before this contract) still blocks cold; new failures use gtmEmailRestrictions",
     "set": {"prospectNotSendable": "EMAIL_BOUNCED"},
     "expect": {"protected": false, "coldExcluded": true, "emailTarget": "pat@alpha.example"}},
    {"name": "company not-sendable reason blocks cold",
     "set": {"prospectNotSendable": "COMPANY_DISSOLVED"},
     "expect": {"protected": false, "coldExcluded": true}},
    {"name": "person opt-out keeps its broader existing effect",
     "set": {"gtmMarketingConsent": "UNSUBSCRIBED"},
     "expect": {"protected": true, "coldExcluded": true}},
    {"name": "person-wide invalid keeps its existing effect",
     "set": {"gtmEligibility": "INVALID"},
     "expect": {"protected": true, "coldExcluded": true}},
    {"name": "client is never cold",
     "set": {"gtmRelationship": "CLIENT"},
     "expect": {"protected": false, "coldExcluded": true}},
    {"name": "colleague on a private client domain is never cold",
     "set": {"emails": {"primaryEmail": "pat@clientco.example", "additionalEmails": []}, "company": {"id": "c-clientco", "name": "Clientco", "domainName": {"primaryLinkUrl": "https://clientco.example"}}, "companyId": "c-clientco"},
     "expect": {"protected": false, "coldExcluded": true}},
    {"name": "network connection is never cold",
     "set": {"gtmOrigins": ["PROSPECT_TOOL", "LINKEDIN"]},
     "expect": {"protected": false, "coldExcluded": true}},
    {"name": "podcast guest is never cold",
     "set": {"gtmOrigins": ["PROSPECT_TOOL", "PODCAST"]},
     "expect": {"protected": false, "coldExcluded": true}},
    {"name": "warm intro, partner and rejected are not sequenced",
     "set": {"prospectReviewState": "WARM_INTRO"},
     "expect": {"protected": false, "coldExcluded": true}},
    {"name": "not tool-sourced is never cold",
     "set": {"gtmOrigins": ["REGENERA"]},
     "expect": {"protected": false, "coldExcluded": true}}
  ]
}
