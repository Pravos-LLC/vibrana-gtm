CONTENT_MODE=sample
DEMO_MODE=1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ZERNIO_API_KEY=
TWENTY_BASE=
TWENTY_API_KEY=
# Team performance (/performance/team). Production only; real values never go in this repo.
# GTM_TEAM_MEMBERS: JSON array, see lib/team/members.ts, e.g.
#   [{"code":"ABE","label":"Abe","authEmail":"...","workspaceMemberId":"<uuid>","apiKeyNames":["..."],"mailboxes":["..."]}]
GTM_TEAM_MEMBERS=
# 32 random bytes, base64 (openssl rand -base64 32): seals mailbox tokens, signs OAuth state, keys recipient hashes.
TEAM_MAILBOX_KEY=
# An Internal OAuth web client in the team's Google Workspace; redirect URI <cockpit>/api/team/mailbox/callback.
TEAM_GMAIL_CLIENT_ID=
TEAM_GMAIL_CLIENT_SECRET=
# Comma-separated domains that are never prospects (the team's own), on top of each mailbox's domain.
TEAM_IGNORE_DOMAINS=
WISE_PROFILE_ID=
WISE_API_TOKEN=
WISE_PRIVATE_KEY_PATH=
OPENROUTER_API_KEY=
RESEND_API_KEY=
CRON_SECRET=
PRIVATE_OVERLAY_ROOT=
PRIVATE_OVERLAY_REVISION=
PRIVATE_OVERLAY_DIGEST=
# Optional additional manual source pin. Provider-bound deployments do not require updating it.
PRIVATE_RELEASE_SHA=
PRIVATE_CONTENT_REPOSITORY=
PRIVATE_CONTENT_REVISION=
PRIVATE_CONTENT_SSH_KEY=
PRIVATE_RUNTIME_DIGEST=
PRIVATE_CONTENT_URL=
PRIVATE_CONTENT_READ_TOKEN=
PRIVATE_CONTENT_BUNDLE_DIGEST=
# Absolute path, outside this checkout, to licensed packaging fonts (gtm packaging render, gallery, motion).
PACKAGING_ASSET_ROOT=
# CLI only: the owner account `gtm story approve|resolve` and `audit --fix` act as when the cockpit has several owners.
GTM_OWNER_EMAIL=
# YouTube Analytics, Reporting and Data APIs for the channel owner (docs/youtube-analytics.md). Server only.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
