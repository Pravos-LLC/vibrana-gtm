CONTENT_MODE=sample
DEMO_MODE=1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ZERNIO_API_KEY=
TWENTY_BASE=
TWENTY_API_KEY=
# Team performance (/performance/team). Production only; real values never go in this repo.
# GTM_TEAM_MEMBERS: JSON array, see lib/team/members.ts, e.g.
#   [{"code":"ABE","label":"Abe","authEmail":"...","workspaceMemberId":"<uuid>","apiKeyNames":["..."],"mailboxes":["..."]}]
GTM_TEAM_MEMBERS=
# 32 random bytes, base64 (openssl rand -base64 32): seals mailbox tokens, signs OAuth state, keys recipient hashes.
TEAM_MAILBOX_KEY=
# An Internal OAuth web client in the team's Google Workspace; redirect URI <cockpit>/api/team/mailbox/callback.
TEAM_GMAIL_CLIENT_ID=
TEAM_GMAIL_CLIENT_SECRET=
# 1 = new mailbox connections ask for gmail.readonly (reply text for classification). Set only after the Google OAuth
# client lists that scope; existing metadata-only connections keep working, and reply text needs their reconnect.
TEAM_GMAIL_READONLY=
# 1 = /performance/team reads email contract v1 (efforts, attempts, coverage) instead of threads. Set only after
# `gtm team reconcile` has been reviewed (VIB-512).
EMAIL_OUTCOMES_V2=
# Email health (VIB-511): sending domains to check daily, `domain` or `domain:dkimSelector`, comma separated; and the
# incident recipients (both owners), comma separated. Without EMAIL_ALERT_TO incidents go to REPORT_EMAIL_TO.
EMAIL_HEALTH_DOMAINS=
EMAIL_ALERT_TO=
# 1 = the hourly team run applies APPROVED email suppression operations to Twenty (VIB-513). Off until the first
# dry-run report (`gtm suppression plan`) is approved by Abe or John. Origami operations stay held regardless.
EMAIL_SUPPRESSION_APPLY=
# Origami opt-outs (VIB-521). ORIGAMI_API_KEY reads replies and campaigns and stops sequences. ORIGAMI_OPTOUT_APPLY=1
# turns the hourly step and the webhook on: confirmed opt-outs set gtmMarketingConsent=UNSUBSCRIBED in Twenty, possible
# ones open an OPT_OUT_REVIEW hold, and the person's live sequences stop in every Origami campaign. Off until the dry run
# (`gtm suppression origami-plan`) is approved. ORIGAMI_WEBHOOK_SECRET is the endpoint's whsec_ signing secret from
# Origami Settings > Developers > Webhooks; the webhook answers 503 until it is set.
ORIGAMI_API_KEY=
ORIGAMI_OPTOUT_APPLY=
ORIGAMI_WEBHOOK_SECRET=
# jev = label reply intent and possible opt-outs with Jev 1.13 through OpenCode (free model first, then paid), needs
# gmail.readonly and OPENCODE_API_KEY. A model opt-out only opens a review; spend is capped in OpenCode, not here.
EMAIL_CLASSIFIER=
OPENCODE_API_KEY=
# Comma-separated domains that are never prospects (the team's own), on top of each mailbox's domain.
TEAM_IGNORE_DOMAINS=
WISE_PROFILE_ID=
WISE_API_TOKEN=
WISE_PRIVATE_KEY_PATH=
OPENROUTER_API_KEY=
RESEND_API_KEY=
CRON_SECRET=
PRIVATE_OVERLAY_ROOT=
PRIVATE_OVERLAY_REVISION=
PRIVATE_OVERLAY_DIGEST=
# Optional additional manual source pin. Provider-bound deployments do not require updating it.
PRIVATE_RELEASE_SHA=
PRIVATE_CONTENT_REPOSITORY=
PRIVATE_CONTENT_REVISION=
PRIVATE_CONTENT_SSH_KEY=
PRIVATE_RUNTIME_DIGEST=
PRIVATE_CONTENT_URL=
PRIVATE_CONTENT_READ_TOKEN=
PRIVATE_CONTENT_BUNDLE_DIGEST=
# Absolute path, outside this checkout, to licensed packaging fonts (gtm packaging render, gallery, motion).
PACKAGING_ASSET_ROOT=
# CLI only: the owner account `gtm story approve|resolve` and `audit --fix` act as when the cockpit has several owners.
GTM_OWNER_EMAIL=
# YouTube Analytics, Reporting and Data APIs for the channel owner (docs/youtube-analytics.md). Server only.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Pipeline (VIB-499): site traffic from the Vercel Web Analytics API, read daily by /api/cron/pipeline. A read-capable
# Vercel token, the team id, and [{"site":"<domain>","projectId":"prj_..."}] per site. Unset: Traffic says "not connected".
VERCEL_ANALYTICS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_ANALYTICS_SITES=
